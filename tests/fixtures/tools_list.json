            "type": "string"
          },
          "data": {
            "description": "Base64 file content",
            "type": "string"
          },
          "filePath": {
            "description": "Local file path, subject to max_upload_bytes",
            "type": "string"
          },
          "name": {
            "description": "Attachment name; required with data",
            "type": "string"
          },
          "setCover": {
            "description": "Use the url image as the card cover",
            "type": "boolean"
          },
          "url": {
            "description": "Link or image URL",
            "type": "string"
          }
        },
        "required": [
          "cardId"
        ],
        "type": "object"
      },
      "name": "add_attachment"
