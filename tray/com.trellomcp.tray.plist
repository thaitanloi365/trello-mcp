<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered into ~/Library/LaunchAgents by `make tray-install`; @HOME@, @CLI@ and @TAILSCALE@ are filled in there. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.trellomcp.tray</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/Applications/Trello MCP.app/Contents/MacOS/trello-mcp-tray</string>
		<!-- The CLI this checkout installs: its servers show "installed" in the Build column. -->
		<string>--cli</string>
		<string>@CLI@</string>
		<!-- host:port=login from `make tailnet`; empty: no "via Tailscale" button. -->
		<string>--tailscale</string>
		<string>@TAILSCALE@</string>
	</array>
	<!-- Login Items names this agent after the app, with its icon. -->
	<key>AssociatedBundleIdentifiers</key>
	<string>com.trellomcp.tray</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- Relaunch only on a crash: Quit exits 0 and stays down until next login. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<!-- Without this, launchd's default throttling can hold status item clicks and stretch the sampling timers. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/trello-mcp-tray.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/trello-mcp-tray.log</string>
</dict>
</plist>
